# Salin ke .env.local untuk development. JANGAN commit .env.local.

# Analytics Umami self-host (opsional sampai Umami terpasang di VPS)
NEXT_PUBLIC_UMAMI_SRC=   # contoh: https://analytics.bimacreative.tech/script.js
NEXT_PUBLIC_UMAMI_ID=    # website id dari Umami

# Tujuan form lead (opsional; tanpa ini form tetap valid tapi tidak diteruskan)
LEAD_WEBHOOK_URL=        # contoh: webhook n8n / Google Apps Script yang meneruskan ke email/WA
