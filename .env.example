# Salin ke .env.local untuk development. JANGAN commit .env.local.

# Analytics Umami self-host (opsional sampai Umami terpasang di VPS)
NEXT_PUBLIC_UMAMI_SRC=   # contoh: https://analytics.bimacreative.tech/script.js
NEXT_PUBLIC_UMAMI_ID=    # website id dari Umami

# Tujuan form lead — WAJIB agar form kontak berfungsi.
# Kosong = /api/lead membalas 503 dan form kontak menampilkan error. Itu disengaja
# (ADR 2026-08-25), bukan bug: situs tidak boleh bilang "Pesan Anda terkirim" kalau
# tidak ada yang menerimanya. Isi env ini sebelum menganggap form berfungsi.
# Dua syarat isi — belum divalidasi kode, jadi murni disiplin operasional:
#   1. Wajib https://. Nama, nomor WA/email, dan isi pesan pengunjung melintas ke
#      tujuan ini; http:// polos berarti data pribadi itu dikirim sebagai teks terang.
#   2. Tujuan wajib milik atau dikendalikan BCT — content/copy/kontak.ts menjanjikan
#      data pengunjung tidak dibagikan ke pihak lain.
LEAD_WEBHOOK_URL=        # mis. endpoint n8n / Google Apps Script milik BCT yang meneruskan ke email/WA
